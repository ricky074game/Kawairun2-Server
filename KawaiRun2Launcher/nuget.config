<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin the package source so the build doesn't depend on broken machine-level
       NuGet sources (e.g. a missing local "Microsoft SDKs\NuGetPackages" folder). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
